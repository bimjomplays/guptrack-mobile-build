  "synopsis": [
   [
    {
     "text": "The name says it all! Denji's life of poverty is changed forever when he merges with his pet chainsaw dog, Pochita! Now he's living in the big city and an official Devil Hunter. But he's got a lot to learn about his new job and chainsaw powers!"
    }
   ],
   [
    {
     "text": "_Notes:"
    }
   ],
   [
    {
     "text": "- Nominated for the 2020 Manga Taisho Award."
    }
   ],
   [
    {
     "text": "- Winner of the 2021 Kono Manga ga Sugoi Award."
    }
   ],
   [
    {
     "text": "- Winner of the 66th Shogakukan Manga Award in the shounen category."
    }
   ],
   [
    {
     "text": "- Winner of the 2021 and 2022 Harvey Award for Best Manga."
    }
   ],
   [
    {
     "text": "- Chapters 1-97 were released in Weekly Shounen Jump from Dec 3, 2018 to Dec 13, 2020. The series resumed from Ch. 98 in Shounen Jump+ on July 12, 2022_"
    }
   ]
